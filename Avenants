    }

    function resetAllFields() {
      document.querySelectorAll('#formSection input[type="text"], #formSection input[type="date"], #formSection input[type="number"]').forEach(el => {
        el.value = '';
      });
      document.getElementById('empCivility').value = 'Monsieur';
      document.getElementById('remArticleNum').value = '6';
      document.getElementById('remMonthlyHours').value = '151.67';
      document.getElementById('cddConvention').value = 'Transports routiers';
      document.getElementById('copiesCount').value = 'deux';
      document.getElementById('renRankNote').value = "Ce renouvellement étant le premier renouvellement du contrat de travail à durée déterminée, un second et dernier renouvellement pourra être proposé au salarié, conformément aux dispositions de l'Article L. 1243-13 du Code du Travail.";
      renderPreview();
    }

    function exportToPDF() {
      const element = document.getElementById('pdfDocument');
      const btn = document.getElementById('downloadPdfBtn');
      const originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span>Génération...</span>';

      const type = document.querySelector('input[name="avenantType"]:checked').value;
      const lastName = getVal('salLastName') || 'Salarie';
      const filename = `Avenant_${type}_${lastName.replace(/\s+/g, '_')}.pdf`;

      const options = {
        margin: 0,
        filename: filename,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, letterRendering: true },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
        pagebreak: { mode: ['css', 'legacy'], avoid: '.avoid-break' }
      };

      html2pdf().set(options).from(element).save()
        .then(() => {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        })
        .catch(() => {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
          alert('Erreur lors de la génération du PDF.');
        });
    }

    window.addEventListener('DOMContentLoaded', () => {
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('signDate').value = today;
      renderPreview();
    });
  </script>
