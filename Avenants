    </section>

  </main>

  <script>
    function formatDateFR(dateStr) {
      if (!dateStr) return null;
      const parts = dateStr.split('-');
      if (parts.length !== 3) return dateStr;
      return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function formatAmount(val) {
      const num = parseFloat(val);
      if (isNaN(num)) return null;
      return num.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function getVal(id) {
      const el = document.getElementById(id);
      return el ? el.value.trim() : '';
    }

    function setText(id, text) {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    }

    function handleAvenantTypeChange() {
      const type = document.querySelector('input[name="avenantType"]:checked').value;

      document.getElementById('blockRenouvellement').classList.toggle('hidden', type !== 'renouvellement');
      document.getElementById('blockRemuneration').classList.toggle('hidden', type !== 'remuneration');
      document.getElementById('blockCddToCdi').classList.toggle('hidden', type !== 'cdd_to_cdi');

      document.getElementById('previewRenouvellement').classList.toggle('hidden', type !== 'renouvellement');
      document.getElementById('previewRemuneration').classList.toggle('hidden', type !== 'remuneration');
      document.getElementById('previewCddToCdi').classList.toggle('hidden', type !== 'cdd_to_cdi');

      renderPreview();
    }

    function switchMobileTab(tab) {
      const formSection = document.getElementById('formSection');
      const previewSection = document.getElementById('previewSection');
      const tabFormBtn = document.getElementById('tabFormBtn');
      const tabPreviewBtn = document.getElementById('tabPreviewBtn');

      if (tab === 'form') {
        formSection.classList.remove('hidden');
        previewSection.classList.add('hidden');
        tabFormBtn.className = 'px-3 py-1.5 rounded-md bg-indigo-600 text-white transition';
        tabPreviewBtn.className = 'px-3 py-1.5 rounded-md text-slate-300 hover:text-white transition';
      } else {
        formSection.classList.add('hidden');
        previewSection.classList.remove('hidden');
        previewSection.classList.add('block');
        tabPreviewBtn.className = 'px-3 py-1.5 rounded-md bg-indigo-600 text-white transition';
        tabFormBtn.className = 'px-3 py-1.5 rounded-md text-slate-300 hover:text-white transition';
      }
    }

    function renderPreview() {
      const type = document.querySelector('input[name="avenantType"]:checked').value;

      const empName = getVal('empName');
      const empForm = getVal('empForm');
      const empCapital = getVal('empCapital');
      const empNaf = getVal('empNaf');
      const empRcsCity = getVal('empRcsCity');
      const empRcsNumber = getVal('empRcsNumber');
      const empAddress = getVal('empAddress');
      const empRepName = getVal('empRepName');
      const empRepRole = getVal('empRepRole');

      const salCivility = getVal('empCivility') || 'Monsieur/Madame';
      const salFirstName = getVal('salFirstName');
      const salLastName = getVal('salLastName');
      const salFullName = [salFirstName, salLastName].filter(Boolean).join(' ');
      const salBirthDate = formatDateFR(getVal('salBirthDate'));
      const salBirthPlace = getVal('salBirthPlace');
      const salAddress = getVal('salAddress');
      const salNationality = getVal('salNationality');
      const salSsn = getVal('salSsn');

      const signCity = getVal('signCity');
      const signDate = formatDateFR(getVal('signDate'));
      const copies = getVal('copiesCount');

      if (type === 'renouvellement') {
        setText('ren_empName', empName || '[Nom de la société]');
        setText('ren_empAddress', empAddress || '[Adresse du siège social] - [Code postal et la ville]');
        setText('ren_empRcsCity', empRcsCity || "[Ville d'enregistrement de la société]");
        setText('ren_empRcsNumber', empRcsNumber || "[Numéro d'enregistrement RCS]");
        setText('ren_empRepName', empRepName || '[Représentant de la société]');
        setText('ren_empRepRole', empRepRole || '[Qualité du représentant]');

        setText('ren_salFullName', salFullName || '[Prénom et Nom]');
        setText('ren_salBirthDate', salBirthDate || '[Date de naissance]');
        setText('ren_salBirthPlace', salBirthPlace || '[Lieu de naissance]');
        setText('ren_salAddress', salAddress || '[Adresse], [Code postal et Ville]');

        setText('ren_duration', getVal('renDuration') || '[Durée du renouvellement]');
        setText('ren_startDate', formatDateFR(getVal('renStartDate')) || '[Début de renouvellement]');
        setText('ren_endDate', formatDateFR(getVal('renEndDate')) || '[Date de fin du renouvellement]');
        setText('ren_rankNote', getVal('renRankNote') || "Ce renouvellement étant le premier renouvellement du contrat de travail à durée déterminée, un second et dernier renouvellement pourra être proposé au salarié, conformément aux dispositions de l'Article L. 1243-13 du Code du Travail.");

        setText('ren_signCity', signCity || '[Ville]');
        setText('ren_signDate', signDate || '[Date]');
        setText('ren_copies', copies || "[Nombre d'exemplaires]");
        setText('ren_signRepName', empRepName || '[Représentant de la société]');
        setText('ren_signSalName', salFullName || '[Prénom et Nom]');
      }

      if (type === 'remuneration') {
        const monthlyRaw = parseFloat(getVal('remMonthlyGross'));
        const annualInputEl = document.getElementById('remAnnualGross');
        if (!isNaN(monthlyRaw) && monthlyRaw > 0 && document.activeElement !== annualInputEl) {
          annualInputEl.value = (monthlyRaw * 12).toFixed(2);
        }
        const annualFormatted = formatAmount(getVal('remAnnualGross'));
        const monthlyFormatted = formatAmount(getVal('remMonthlyGross'));
        const hoursVal = getVal('remMonthlyHours');

        setText('rem_empName', empName || '(Dénomination sociale)');
        setText('rem_empForm', empForm || '(Forme)');
        setText('rem_empCapital', empCapital || '(Capital)');
        setText('rem_empNaf', empNaf || '(code NAF)');
        setText('rem_empAddress', empAddress || '(Siège social/adresse)');
        setText('rem_empRepName', empRepName || '(Nom) (Prénom)');
        setText('rem_empRepRole', empRepRole || '(Qualité)');

        setText('rem_salCivility', salCivility);
        setText('rem_salCivility2', salCivility);
        setText('rem_salFullName', salFullName || '(Nom) (Prénom)');
        setText('rem_salFullName2', salFullName || '(Prénom) (Nom)');
        setText('rem_salAddress', salAddress || '(Adresse)');
        setText('rem_salBirthDate', salBirthDate || '(Date)');
        setText('rem_salBirthPlace', salBirthPlace || '(Lieu)');
        setText('rem_salNationality', salNationality || '(Préciser la nationalité)');
        setText('rem_salSsn', salSsn || '(numéro de sécurité sociale)');

        setText('rem_artNum', getVal('remArticleNum') || "(Précisez le numéro de l'article selon le contrat)");
        setText('rem_monthlyGross', monthlyFormatted || '(Montant)');
        setText('rem_monthlyHours', hoursVal ? hoursVal.replace('.', ',') : '(Heures mensuelles travaillées)');
        setText('rem_annualGross', annualFormatted || '(Montant)');

        setText('rem_signCity', signCity || '(Ville)');
        setText('rem_signDate', signDate || '(Date)');
        setText('rem_copies', copies || 'deux');
      }

      if (type === 'cdd_to_cdi') {
        setText('cdi_empName', empName || '(dénomination sociale)');
        setText('cdi_empForm', empForm || '(forme)');
        setText('cdi_empCapital', empCapital || '(capital)');
        setText('cdi_empNaf', empNaf || '(code NAF)');
        setText('cdi_empAddress', empAddress || '(siège social/adresse)');
        setText('cdi_empRepName', empRepName || '(nom) (prénom)');
        setText('cdi_empRepRole', empRepRole || '(qualité)');

        setText('cdi_salCivility', salCivility);
        setText('cdi_salCivility2', salCivility);
        setText('cdi_salCivility3', salCivility);
        setText('cdi_salFullName', salFullName || '(nom) (prénom)');
        setText('cdi_salFullName2', salFullName || '(nom) (prénom)');
        setText('cdi_salFullName3', salFullName || '(nom) (prénom)');
        setText('cdi_salAddress', salAddress || '(adresse)');
        setText('cdi_salBirthDate', salBirthDate || '(date)');
        setText('cdi_salBirthPlace', salBirthPlace || '(lieu)');
        setText('cdi_salNationality', salNationality || '(Préciser la nationalité)');
        setText('cdi_salSsn', salSsn || '(numéro de sécurité sociale)');

        setText('cdi_initDate', formatDateFR(getVal('cddInitDate')) || '(Préciser la date)');
        setText('cdi_expDate', formatDateFR(getVal('cddExpDate')) || '(date)');
        setText('cdi_jobTitle', getVal('cddJobTitle') || '(qualité)');
        setText('cdi_coef', getVal('cddCoef') || '(coefficient)');
        setText('cdi_echelon', getVal('cddEchelon') || '(échelon)');
        setText('cdi_convention', getVal('cddConvention') || '(Convention collective)');
        setText('cdi_reason', getVal('cddReason') || '(rappeler le motif du recours au CDD)');

        setText('cdi_signCity', signCity || '(lieu)');
        setText('cdi_signDate', signDate || '(date)');
        setText('cdi_copies', copies || "(nombre d'exemplaires)");
      }
    }

