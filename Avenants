              </div>
              <div>
                <p class="font-bold text-sm">Le salarié :</p>
                <p id="ren_signSalName" class="text-sm mt-0.5">[Prénom et Nom]</p>
                <p class="text-xs text-slate-600 mt-1">Signature précédée de la mention « lu et approuvé »</p>
                <div class="h-20"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- MODÈLE 2 : RÉMUNÉRATION / AUGMENTATION -->
        <div id="previewRemuneration" class="hidden">
          <h1 class="text-center text-base font-bold text-slate-900 mb-8">
            Avenant au contrat de travail – Rémunération
          </h1>

          <p class="font-bold text-sm mb-4">Entre les soussignés :</p>

          <p class="mb-3 text-justify pl-4">
            • &nbsp;La Société <strong id="rem_empName">(Dénomination sociale)</strong>, <span id="rem_empForm">(Forme)</span>, au capital de <strong id="rem_empCapital">(Capital)</strong> €, code NAF : <span id="rem_empNaf">(code NAF)</span>, dont le siège est situé <span id="rem_empAddress">(Siège social/adresse)</span>, représentée par <strong id="rem_empRepName">(Nom) (Prénom)</strong>, en sa qualité de <span id="rem_empRepRole">(Qualité)</span>.
